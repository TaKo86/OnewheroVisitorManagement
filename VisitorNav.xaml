<Page x:Class="OnewheroVisitorManagement.View.VisitorNav"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:OnewheroVisitorManagement.ViewModel"
        xmlns:Menu="clr-namespace:OnewheroVisitorManagement.Utilities"
	    Background="#FF1E1E1E">

	<Grid>
		<!-- navbar layout -->
		<Grid.RowDefinitions>
			<RowDefinition Height="80"/>
			<RowDefinition Height="*" />			   
		</Grid.RowDefinitions>


		<Border Background="#3b5833" Grid.Row="0" CornerRadius="20,20,0,0">
			<DockPanel VerticalAlignment="Center" LastChildFill="False">
				<!--left logo and name -->
				<StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="20,0">
					<Image Source="/Images/logo.png" Height="40" VerticalAlignment="Center"/>
					<TextBlock Text="OneWhero Bay Heritage Park"
							   Foreground="White"
							   FontWeight="Bold"
							   FontSize="18"
							   Margin="10,0,0,0"
							   VerticalAlignment="Center"/>
				</StackPanel>
				
				<!-- nav buttons-->
				<StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="80,0,0,0" VerticalAlignment="Center">
					
					<Menu:Btn Content="About us" Style="{StaticResource BtnStyle}"
							Command="{Binding AboutCommand}"/>
					<Menu:Btn Content="Events" Style="{StaticResource BtnStyle}"
							Command="{Binding VisitorEventsCommand}"/>
					<Menu:Btn Content="Contact us" Style="{StaticResource BtnStyle}"
							Command="{Binding ContactCommand}"/>
				</StackPanel>
				
				<!-- right profile pic-->
				<Ellipse x:Name="UserIconEllipse"
						 DockPanel.Dock="Right"
						 Width="40"
						 Height="40"
						 Margin="0,0,20,0"
						 Stroke="Transparent">
				</Ellipse>	
			</DockPanel>
		</Border>
		
		<!-- hero section-->
		<Grid x:Name="HeroGrid" Grid.Row="1">
			<Border x:Name="DarkOverlay" Background="#80000000"/> <!--dark overlay-->
			
			<StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Grid.ZIndex="1">
				<TextBlock Text="Welcome to"
                       Foreground="White"
                       FontSize="20"
                       FontStyle="Italic"
						  TextAlignment="Center"
                       Margin="0,0,0,10"/>
				<TextBlock Text="Onewhero Bay Heritage Park"
						   Foreground="White"
						   FontWeight="Bold"
						   FontSize="32"/>
				<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
					<Button Content="Browse Attractions" Style="{StaticResource ActionButtonStyle}" Background="#2E8B57" Margin="0,0,10,0"/>
					<Button Content="Register" Style="{StaticResource ActionButtonStyle}" Background="#40E0D0" Margin="0,0,10,0"/>
					<Button Content="Current Events" Style="{StaticResource ActionButtonStyle}" Background="#483D8B"/>
				</StackPanel>
			</StackPanel>
		</Grid>
	</Grid>

